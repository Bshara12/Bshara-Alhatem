    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Bshara AlHatem",
        "jobTitle": "Backend Engineer",
        "email": "mailto:bshara.h2003@gmail.com",
        "url": "https://bshara12.github.io/Bshara-Alhatem/",
        "sameAs": ["https://github.com/Bshara12"]
      }
    </script>
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --navy: #0f172a;
        --navy2: #1e293b;
        --navy3: #334155;
        --accent: #3b82f6;
        --accent2: #60a5fa;
        --text: #e2e8f0;
        --muted: #94a3b8;
        --border: #1e293b;
        --white: #f8fafc;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: "Inter", sans-serif;
        background: var(--navy);
        color: var(--text);
        line-height: 1.7;
        font-size: 16px;
      }

      a {
        color: var(--accent2);
        text-decoration: none;
        transition: color 0.2s;
      }
      a:hover {
        color: var(--white);
      }

      /* ── LAYOUT ── */
      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      /* ── NAV ── */
      nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        background: rgba(15, 23, 42, 0.92);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
      }
      .nav-inner {
        max-width: 1100px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.9rem 2rem;
      }
      .nav-logo {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--white);
        letter-spacing: -0.3px;
      }
      .nav-logo span {
        color: var(--accent);
      }
      .nav-links {
        display: flex;
        gap: 2rem;
        list-style: none;
      }
      .nav-links a {
        font-size: 0.9rem;
        color: var(--muted);
        font-weight: 500;
        letter-spacing: 0.3px;
      }
      .nav-links a:hover {
        color: var(--accent2);
      }
      .nav-cta {
        background: transparent;
        border: 1px solid var(--accent);
        color: var(--accent2);
        padding: 0.45rem 1.1rem;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
      }
      .nav-cta:hover {
        background: rgba(59, 130, 246, 0.1);
      }

      /* ── HERO ── */
      #hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        padding-top: 80px;
      }
      .hero-inner {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 4rem;
        align-items: center;
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 2rem;
      }
      .hero-tag {
        font-size: 0.85rem;
        color: var(--accent2);
        font-weight: 500;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 1rem;
      }
      .hero-name {
        font-size: clamp(2.4rem, 5vw, 3.8rem);
        font-weight: 600;
        color: var(--white);
        line-height: 1.1;
        letter-spacing: -1px;
        margin-bottom: 0.8rem;
      }
      .hero-title {
        font-size: clamp(1.2rem, 2.5vw, 1.8rem);
        color: var(--muted);
        font-weight: 400;
        margin-bottom: 1.5rem;
      }
      .hero-desc {
        font-size: 1rem;
        color: var(--muted);
        max-width: 520px;
        margin-bottom: 2.5rem;
        line-height: 1.8;
      }
      .hero-btns {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .btn-primary {
        background: var(--accent);
        color: #fff;
        padding: 0.7rem 1.6rem;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 500;
        transition: background 0.2s;
        border: none;
        cursor: pointer;
      }
      .btn-primary:hover {
        background: #2563eb;
        color: #fff;
      }
      .btn-outline {
        border: 1px solid var(--navy3);
        color: var(--text);
        padding: 0.7rem 1.6rem;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 500;
        transition: all 0.2s;
      }
      .btn-outline:hover {
        border-color: var(--accent2);
        color: var(--accent2);
      }
      .hero-avatar {
        width: 200px;
        height: 200px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--accent);
        box-shadow: 0 0 0 6px rgba(59, 130, 246, 0.12);
      }

      /* ── SECTION BASE ── */
      section {
        padding: 6rem 0;
      }
      .section-label {
        font-size: 0.8rem;
        color: var(--accent2);
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 0.6rem;
      }
      .section-title {
        font-size: clamp(1.6rem, 3vw, 2.2rem);
        color: var(--white);
        font-weight: 600;
        margin-bottom: 1rem;
        letter-spacing: -0.5px;
      }
      .section-line {
        width: 48px;
        height: 3px;
        background: var(--accent);
        border-radius: 2px;
        margin-bottom: 3rem;
      }

      /* ── ABOUT ── */
      .about-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 4rem;
        align-items: start;
      }
      .about-text p {
        color: var(--muted);
        margin-bottom: 1.2rem;
        line-height: 1.8;
      }
      .about-text p strong {
        color: var(--text);
      }
      .about-links {
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
      }
      .about-link {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.9rem;
        color: var(--muted);
        border: 1px solid var(--border);
        padding: 0.5rem 1rem;
        border-radius: 6px;
        transition: all 0.2s;
      }
      .about-link:hover {
        border-color: var(--accent);
        color: var(--accent2);
      }
      .about-img {
        width: 100%;
        max-width: 280px;
        border-radius: 12px;
        border: 2px solid var(--navy3);
        object-fit: cover;
      }

      /* ── STACK ── */
      #stack {
        background: var(--navy2);
      }
      .stack-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
      }
      .stack-card {
        background: var(--navy);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem;
        transition: border-color 0.2s;
      }
      .stack-card:hover {
        border-color: var(--navy3);
      }
      .stack-card-title {
        font-size: 0.75rem;
        color: var(--accent2);
        font-weight: 600;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 1rem;
      }
      .stack-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .tag {
        background: rgba(59, 130, 246, 0.1);
        color: var(--accent2);
        border: 1px solid rgba(59, 130, 246, 0.2);
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .tag.proficient {
        background: rgba(59, 130, 246, 0.15);
        border-color: rgba(59, 130, 246, 0.35);
      }
      .tag.familiar {
        background: rgba(148, 163, 184, 0.08);
        color: var(--muted);
        border-color: rgba(148, 163, 184, 0.2);
      }

      /* ── PROJECTS ── */
      .projects-grid {
        display: flex;
        flex-direction: column;
        gap: 1.8rem;
      }
      .project-card {
        background: var(--navy);
        border: 1px solid var(--border);
        border-left: 3px solid var(--accent);
        border-radius: 12px;
        padding: 2rem 2.2rem;
        transition:
          border-color 0.2s,
          transform 0.2s;
      }
      .project-card:hover {
        border-color: var(--navy3);
        border-left-color: var(--accent2);
        transform: translateY(-3px);
      }
      .project-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.4rem;
      }
      .project-number {
        font-size: 0.75rem;
        color: var(--accent2);
        font-weight: 600;
        letter-spacing: 1.2px;
        text-transform: uppercase;
      }
      .project-name {
        font-size: 1.35rem;
        color: var(--white);
        font-weight: 600;
        margin-bottom: 0.15rem;
        letter-spacing: -0.3px;
      }
      .project-line {
        display: grid;
        grid-template-columns: 96px 1fr;
        gap: 1rem;
        padding: 0.7rem 0;
        border-top: 1px solid var(--border);
      }
      .project-line-label {
        font-size: 0.72rem;
        color: var(--muted);
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding-top: 0.28rem;
      }
      .project-line p {
        color: var(--muted);
        font-size: 0.93rem;
        line-height: 1.8;
      }
      .project-line.result .project-line-label {
        color: var(--accent2);
      }
      .project-line.result p {
        color: var(--text);
      }
      .project-desc {
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.8;
        margin-bottom: 1.5rem;
      }
      .project-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-top: 1.4rem;
        margin-bottom: 1rem;
      }
      .stat-chip {
        background: var(--navy2);
        border: 1px solid var(--border);
        color: var(--text);
        padding: 0.3rem 0.8rem;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .stat-chip.highlight {
        background: rgba(59, 130, 246, 0.1);
        border-color: rgba(59, 130, 246, 0.25);
        color: var(--accent2);
      }
      .project-tech {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
      }
      .tech-tag {
        font-size: 0.78rem;
        color: var(--muted);
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--border);
        padding: 0.25rem 0.7rem;
        border-radius: 4px;
        font-family: "Inter", monospace;
      }
      .project-links {
        display: flex;
        gap: 1rem;
      }
      .project-link {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
        color: var(--muted);
        transition: color 0.2s;
      }
      .project-link:hover {
        color: var(--accent2);
      }
      .project-link svg {
        width: 16px;
        height: 16px;
      }

      /* ── OTHER PROJECTS ── */
      .other-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-top: 1rem;
      }
      .other-card {
        background: var(--navy2);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem;
        transition: all 0.2s;
        display: flex;
        flex-direction: column;
      }
      .other-card:hover {
        border-color: var(--navy3);
        transform: translateY(-3px);
      }
      .other-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1rem;
      }
      .folder-icon {
        color: var(--accent2);
      }
      .other-card-links {
        display: flex;
        gap: 0.7rem;
      }
      .other-card-links a {
        color: var(--muted);
        transition: color 0.2s;
      }
      .other-card-links a:hover {
        color: var(--accent2);
      }
      .other-card h4 {
        font-size: 1rem;
        color: var(--white);
        font-weight: 500;
        margin-bottom: 0.6rem;
      }
      .other-card p {
        font-size: 0.85rem;
        color: var(--muted);
        line-height: 1.7;
        flex: 1;
        margin-bottom: 1.2rem;
      }
      .other-tech {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: auto;
      }
      .other-tech span {
        font-size: 0.75rem;
        color: var(--muted);
        font-family: "Inter", monospace;
      }
      .other-tech span:not(:last-child)::after {
        content: "·";
        margin-left: 0.4rem;
      }

      /* ── EXPERIENCE ── */
      #experience {
        background: var(--navy2);
      }
      .timeline {
        position: relative;
        padding-left: 2rem;
      }
      .timeline::before {
        content: "";
        position: absolute;
        left: 0;
        top: 8px;
        bottom: 8px;
        width: 2px;
        background: var(--border);
        border-radius: 2px;
      }
      .timeline-item {
        position: relative;
        margin-bottom: 3rem;
      }
      .timeline-item:last-child {
        margin-bottom: 0;
      }
      .timeline-dot {
        position: absolute;
        left: -2.45rem;
        top: 6px;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--accent);
        border: 2px solid var(--navy2);
      }
      .timeline-date {
        font-size: 0.78rem;
        color: var(--accent2);
        font-weight: 600;
        letter-spacing: 0.5px;
        margin-bottom: 0.4rem;
      }
      .timeline-role {
        font-size: 1.05rem;
        color: var(--white);
        font-weight: 500;
        margin-bottom: 0.3rem;
      }
      .timeline-org {
        font-size: 0.9rem;
        color: var(--muted);
        margin-bottom: 0.8rem;
      }
      .timeline-desc {
        font-size: 0.9rem;
        color: var(--muted);
        line-height: 1.8;
      }
      .timeline-desc li {
        margin-bottom: 0.4rem;
      }

      /* ── EDUCATION ── */
      .edu-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
      }
      .edu-card {
        background: var(--navy2);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem;
      }
      .edu-card-year {
        font-size: 0.78rem;
        color: var(--accent2);
        font-weight: 600;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
      }
      .edu-card h4 {
        font-size: 1rem;
        color: var(--white);
        font-weight: 500;
        margin-bottom: 0.3rem;
      }
      .edu-card p {
        font-size: 0.85rem;
        color: var(--muted);
      }

      /* ── CONTACT ── */
      .contact-wrap {
        max-width: 600px;
        margin: 0 auto;
        text-align: center;
      }
      .contact-wrap .section-line {
        margin: 0 auto 3rem;
      }
      .contact-intro {
        color: var(--muted);
        font-size: 1rem;
        line-height: 1.8;
        margin-bottom: 2.5rem;
      }
      .contact-links {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 2.5rem;
      }
      .contact-link-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--muted);
        font-size: 0.9rem;
        border: 1px solid var(--border);
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        transition: all 0.2s;
      }
      .contact-link-item:hover {
        border-color: var(--accent);
        color: var(--accent2);
      }
      .contact-link-item svg {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
      }

      /* ── FOOTER ── */
      footer {
        text-align: center;
        padding: 2.5rem;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.82rem;
      }
      footer a {
        color: var(--muted);
      }
      footer a:hover {
        color: var(--accent2);
      }

      /* ── MOBILE ── */
      @media (max-width: 768px) {
        .hero-inner {
          grid-template-columns: 1fr;
          text-align: center;
        }
        .hero-avatar {
          width: 140px;
          height: 140px;
          margin: 0 auto;
        }
        .hero-btns {
          justify-content: center;
        }
        .hero-desc {
          margin-left: auto;
          margin-right: auto;
        }
        .about-grid {
          grid-template-columns: 1fr;
        }
        .about-img {
          display: none;
        }
        .project-card {
          padding: 1.5rem 1.3rem;
        }
        .project-line {
          grid-template-columns: 1fr;
          gap: 0.2rem;
        }
        .nav-links {
          display: none;
        }
      }

      /* ── HERO ENTRANCE ANIMATIONS ── */
      @keyframes fadeUp {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes avatarPop {
        0% {
          opacity: 0;
          transform: scale(0.82) translateY(20px);
        }
        65% {
          transform: scale(1.05) translateY(-4px);
        }
        100% {
          opacity: 1;
          transform: scale(1) translateY(0);
        }
      }
      @keyframes tagSlide {
        from {
          opacity: 0;
          transform: translateX(-14px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }
      @keyframes cursorBlink {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0;
        }
      }

      .hero-tag {
        opacity: 0;
        animation: tagSlide 0.5s ease both 0.1s;
      }
      .hero-name {
        opacity: 0;
        animation: fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) both 0.25s;
      }
      .hero-title {
        opacity: 0;
        animation: fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) both 0.42s;
      }
      .hero-desc {
        opacity: 0;
        animation: fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) both 0.58s;
      }
      .hero-btns {
        opacity: 0;
        animation: fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) both 0.72s;
      }
      .hero-avatar {
        opacity: 0;
        animation: avatarPop 0.85s cubic-bezier(0.22, 1, 0.36, 1) both 0.3s;
      }

      .hero-name::after {
        content: "|";
        color: var(--accent);
        margin-left: 3px;
        font-weight: 300;
        animation: cursorBlink 1s step-end infinite 1.4s;
      }

      /* ── SCROLL REVEAL ── */
      .reveal {
        opacity: 0;
        transform: translateY(36px);
        transition:
          opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
          transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .reveal.from-left {
        transform: translateX(-36px);
      }
      .reveal.from-right {
        transform: translateX(36px);
      }
      .reveal.visible {
        opacity: 1;
        transform: translate(0, 0);
      }
    </style>
    <!-- <meta name="google-site-verification" content="SIXH_nHHozg9ml6KE_2mFWudnuwDO0xh3srVtlqzmY0" /> -->
  </head>
  <body>
    <!-- NAV -->
    <nav>
      <div class="nav-inner">
